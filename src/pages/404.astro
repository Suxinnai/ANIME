---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Home, ArrowLeft, Construction } from "lucide-react";

const imagePath = "/正面形象.png";
---

<BaseLayout title="404: 施工现场 | Anime Log">
    <div
        class="min-h-[80vh] flex items-center justify-center relative overflow-hidden py-20"
    >
        <div
            class="container-custom flex flex-col md:flex-row items-center justify-center gap-12 md:gap-24 relative z-10"
        >
            <!-- Visual Group (Left) -->
            <div class="relative flex-shrink-0">
                <!-- 404 Box Frame -->
                <div
                    class="absolute -left-6 top-10 border-4 border-[#00d7c0] rounded-2xl px-8 py-0 bg-white dark:bg-[#1e1e1e] shadow-[8px_8px_0px_#00d7c0] transform -rotate-3 select-none z-0"
                >
                    <span
                        class="font-display font-black text-[8rem] md:text-[10rem] leading-none text-[#00d7c0] tracking-tighter"
                    >
                        404
                    </span>
                </div>

                <!-- Character Image -->
                <div
                    class="relative z-10 w-64 md:w-[22rem] transform hover:-translate-y-2 transition-transform duration-500"
                >
                    <img
                        src={imagePath}
                        alt="Anime Character"
                        class="w-full h-auto drop-shadow-2xl filter brightness-105"
                    />
                    <!-- Cyan Glow -->
                    <div
                        class="absolute inset-0 bg-[#00d7c0]/20 blur-3xl -z-10 rounded-full scale-75"
                    >
                    </div>
                </div>
            </div>

            <!-- Content Group (Right) -->
            <div
                class="flex flex-col items-center md:items-start text-center md:text-left space-y-8 max-w-lg"
            >
                <div class="space-y-4">
                    <div
                        class="inline-flex items-center gap-2 px-3 py-1 bg-[#00d7c0]/10 text-[#00d7c0] rounded-full text-sm font-bold border border-[#00d7c0]/20"
                    >
                        <Construction className="w-4 h-4 animate-bounce" />
                        <span>System Notice</span>
                    </div>

                    <h1
                        class="text-4xl md:text-6xl font-display font-bold text-anime-dark dark:text-white leading-tight"
                    >
                        页面正在<br />
                        <span class="text-[#00d7c0]">规划施工</span>中...
                    </h1>

                    <p
                        class="text-anime-dark/60 dark:text-gray-400 text-lg md:text-xl font-medium leading-relaxed"
                    >
                        哎呀，这里的代码还在异世界漂流。<br />
                        请耐心等待建筑师少女的施工吧！
                    </p>
                </div>

                <!-- Action Buttons -->
                <div class="flex items-center gap-4">
                    <button
                        onclick="history.back()"
                        class="px-8 py-3 bg-white dark:bg-[#1e1e1e] border-2 border-gray-200 dark:border-white/10 rounded-2xl font-bold text-gray-500 hover:text-anime-dark dark:hover:text-white hover:border-anime-dark transition-all flex items-center gap-2 shadow-sm hover:translate-y-[-2px]"
                    >
                        <ArrowLeft className="w-4 h-4" />
                        撤退
                    </button>

                    <a
                        href="/"
                        class="px-10 py-3 bg-[#00d7c0] text-white border-2 border-[#00aa95] rounded-2xl font-bold shadow-[4px_4px_0px_#00aa95] hover:translate-y-[-2px] hover:shadow-[6px_6px_0px_#00aa95] transition-all flex items-center gap-2"
                    >
                        <Home className="w-4 h-4" />
                        回首页
                    </a>
                </div>
            </div>
        </div>

        <!-- Background Decor -->
        <div
            class="absolute inset-0 pointer-events-none overflow-hidden select-none"
        >
            <div
                class="absolute top-[15%] left-[10%] text-[#00d7c0]/5 font-bold text-9xl -rotate-12"
            >
                ?
            </div>
            <div
                class="absolute bottom-[10%] right-[5%] text-[#00d7c0]/5 font-bold text-[12rem] rotate-6"
            >
                null
            </div>
            <div
                class="absolute top-1/2 right-0 w-96 h-96 bg-[#00d7c0]/5 rounded-full blur-3xl -translate-y-1/2 translate-x-1/2"
            >
            </div>
        </div>
    </div>
</BaseLayout>
```
