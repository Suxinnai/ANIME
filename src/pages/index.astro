---
import BaseLayout from "../layouts/BaseLayout.astro";
import BlogCard from "../components/BlogCard.astro";
import DigitalTwin from "../components/DigitalTwinReact.jsx"; // Use React version
import { getCollection } from "astro:content";
import { ArrowRight, Sparkles, Gamepad2, Trophy } from "lucide-react";
import { getActiveRoadmap } from "../data/roadmaps/index";

const roadmapData = getActiveRoadmap();

// Calculate progress for homepage widget
let totalItems = 0;
let completedItems = 0;
roadmapData.sections.forEach((section) => {
    section.items.forEach((item) => {
        totalItems++;
        if (item.completed) completedItems++;
        if (item.children) {
            item.children.forEach((child) => {
                totalItems++;
                if (child.completed) completedItems++;
            });
        }
    });
});
const progressPercent = Math.round((completedItems / totalItems) * 100);

// Get latest 3 posts
const posts = (await getCollection("blog"))
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
    .slice(0, 3);
---

<BaseLayout
    title="Suxinnaiの异世界"
    description="Suxinnai 的数字异世界 - 记录代码、设计与生活的冒险"
>
    <!-- Hero Section -->
    <section
        class="relative min-h-[90vh] flex items-center justify-center overflow-hidden pt-20"
    >
        <!-- Background Grid -->
        <div class="absolute inset-0 z-0">
            <div
                class="absolute inset-0 bg-white dark:bg-[#121212] transition-colors duration-500"
            >
            </div>
            <div
                class="absolute inset-0 opacity-[0.03]"
                style="background-image: radial-gradient(#000 1px, transparent 1px); background-size: 30px 30px;"
            >
            </div>
        </div>

        <div
            class="container-custom relative z-10 grid grid-cols-1 lg:grid-cols-2 gap-12 items-center"
        >
            <!-- Left: Text Content -->
            <div class="space-y-8 animate-fade-in-up">
                <!-- Badge -->
                <div
                    class="inline-flex items-center gap-2 px-4 py-2 bg-anime-yellow border-2 border-anime-dark rounded-full shadow-comic-sm transform hover:-rotate-2 transition-transform cursor-default"
                >
                    <Gamepad2 className="w-4 h-4 text-anime-dark" />
                    <span
                        class="font-display font-bold text-xs uppercase tracking-widest text-anime-dark"
                        >Mission Start!</span
                    >
                </div>

                <h1
                    class="text-5xl sm:text-7xl lg:text-8xl font-display font-black leading-[0.9] text-anime-dark dark:text-white tracking-tighter"
                >
                    Coding <br />
                    <span class="text-anime-blue relative inline-block">
                        Adventure
                        <Sparkles
                            className="absolute -top-4 -right-6 sm:-top-6 sm:-right-8 w-8 h-8 sm:w-12 sm:h-12 text-anime-yellow animate-bounce-slow"
                        />
                        <svg
                            class="absolute w-full h-2 sm:h-3 -bottom-1 sm:-bottom-2 left-0 text-anime-pink"
                            viewBox="0 0 100 10"
                            preserveAspectRatio="none"
                        >
                            <path
                                d="M0 5 Q 50 10 100 5"
                                stroke="currentColor"
                                stroke-width="8"
                                fill="none"></path>
                        </svg>
                    </span>
                </h1>

                <p
                    class="text-xl text-anime-dark/70 dark:text-gray-400 max-w-lg font-medium leading-relaxed"
                >
                    欢迎来到我的数字异世界。这里记录了关于<span
                        class="font-bold text-anime-pink border-b-2 border-anime-pink/30"
                        >代码</span
                    >、<span
                        class="font-bold text-anime-blue border-b-2 border-anime-blue/30"
                        >设计</span
                    >与生活的<strong class="text-anime-dark dark:text-white"
                        >主线任务</strong
                    >攻略。
                </p>

                <!-- System Notice (Typewriter Style) -->
                <div
                    class="w-full max-w-md bg-black/5 dark:bg-white/5 border border-black/10 dark:border-white/10 rounded-lg p-3 flex items-center gap-3 overflow-hidden group hover:bg-black/10 dark:hover:bg-white/10 transition-colors"
                >
                    <div
                        class="flex-shrink-0 w-2 h-2 bg-green-500 rounded-full animate-pulse"
                    >
                    </div>
                    <div class="flex-grow overflow-hidden relative h-5">
                        <span
                            class="block text-xs font-mono text-anime-dark/70 dark:text-gray-300 whitespace-nowrap overflow-hidden border-r-2 border-anime-dark/50 animate-typing"
                        >
                            [System] User connected. Adventure awaits!
                        </span>
                    </div>
                </div>

                <div class="flex flex-wrap gap-4 pt-4">
                    <a
                        href="/blog"
                        class="px-8 py-4 bg-anime-pink text-white font-display font-bold text-lg rounded-xl border-2 border-anime-dark shadow-comic hover:translate-y-[-4px] hover:shadow-comic-hover transition-all flex items-center gap-2 group"
                    >
                        开始阅读
                        <ArrowRight
                            className="w-5 h-5 group-hover:translate-x-1 transition-transform"
                        />
                    </a>
                    <a
                        href="/about"
                        class="px-8 py-4 bg-white dark:bg-transparent text-anime-dark dark:text-white font-display font-bold text-lg rounded-xl border-2 border-anime-dark dark:border-white/20 shadow-comic dark:shadow-none hover:bg-gray-50 dark:hover:bg-white/5 transition-all"
                    >
                        角色属性
                    </a>
                </div>
            </div>

            <!-- Right: Digital Twin Component -->
            <div
                class="relative z-10 lg:h-[600px] flex items-center justify-center"
            >
                <!-- The Digital Twin Component -->
                <div
                    class="w-full max-w-md transform hover:scale-[1.02] transition-transform duration-500"
                >
                    <DigitalTwin client:load />
                </div>

                <!-- Decorative Elements behind -->
                <div
                    class="absolute -z-10 top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[120%] h-[120%] bg-gradient-to-tr from-anime-blue/20 to-anime-pink/20 blur-3xl rounded-full opacity-50 animate-pulse-slow"
                >
                </div>
            </div>
        </div>

        <!-- Wave Divider -->
        <div
            class="absolute bottom-0 left-0 w-full leading-[0] z-10 text-white dark:text-[#121212]"
        >
            <svg
                data-name="Layer 1"
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 1200 120"
                preserveAspectRatio="none"
                class="relative block h-[60px] w-full fill-current"
            >
                <path
                    d="M321.39,56.44c58-10.79,114.16-30.13,172-41.86,82.39-16.72,168.19-17.73,250.45-.39C823.78,31,906.67,72,985.66,92.83c70.05,18.48,146.53,26.09,214.34,3V0H0V27.35A600.21,600.21,0,0,0,321.39,56.44Z"
                ></path>
            </svg>
        </div>
    </section>

    <!-- Learning Path Section -->
    <section
        class="py-16 pt-24 bg-white dark:bg-[#121212] relative overflow-hidden"
    >
        <div class="container-custom">
            <div
                class="card-comic p-8 md:p-10 bg-white/40 dark:bg-white/5 backdrop-blur-md border-dashed border-2 border-anime-blue/20 flex flex-col md:flex-row items-center justify-between gap-8 md:gap-12 relative z-10 overflow-hidden group hover:border-anime-blue/40 transition-colors duration-500"
            >
                <!-- Radiant Background behind card -->
                <div
                    class="absolute inset-0 bg-gradient-to-br from-anime-blue/5 via-transparent to-anime-pink/5 opacity-50 group-hover:opacity-100 transition-opacity duration-500"
                >
                </div>

                <div
                    class="space-y-4 text-center md:text-left relative z-10 max-w-xl"
                >
                    <h2
                        class="text-3xl md:text-4xl font-display text-anime-dark dark:text-white flex items-center justify-center md:justify-start gap-3"
                    >
                        <span
                            class="w-10 h-10 bg-anime-yellow rounded-xl flex items-center justify-center text-anime-dark shadow-sm rotate-3 group-hover:rotate-12 transition-transform duration-300"
                        >
                            <Sparkles className="w-6 h-6" />
                        </span>
                        当前修炼路线
                    </h2>
                    <p
                        class="text-lg text-anime-dark/70 dark:text-gray-300 italic font-medium leading-relaxed"
                    >
                        <span class="text-anime-pink font-bold"
                            >" {roadmapData.title} "</span
                        >
                        <br />
                        <span class="text-sm opacity-80"
                            >正在攻克主线任务，向着成为 Legend 进发！</span
                        >
                    </p>
                </div>

                <div
                    class="w-full md:w-auto flex-grow max-w-sm ml-auto relative z-10"
                >
                    <div
                        class="bg-white/50 dark:bg-black/20 rounded-2xl p-6 border border-white/50 dark:border-white/5 shadow-sm"
                    >
                        <div class="flex justify-between items-end mb-3">
                            <span
                                class="font-display text-anime-blue text-sm tracking-widest font-bold"
                                >EXP GAINED</span
                            >
                            <div class="flex items-baseline gap-1">
                                <span
                                    class="font-display text-3xl text-anime-dark dark:text-white"
                                    >{progressPercent}</span
                                >
                                <span class="text-xs font-bold text-anime-pink"
                                    >%</span
                                >
                            </div>
                        </div>

                        <!-- Animated Progress Bar -->
                        <div
                            class="h-4 bg-gray-100 dark:bg-white/10 rounded-full overflow-hidden p-0.5"
                        >
                            <div
                                class="h-full rounded-full bg-gradient-to-r from-anime-blue to-anime-pink relative overflow-hidden"
                                style={`width: ${progressPercent}%`}
                            >
                                <div
                                    class="absolute inset-0 bg-[url('data:image/svg+xml;base64,')] animate-[slide_1s_linear_infinite]"
                                >
                                </div>
                            </div>
                        </div>

                        <div class="mt-4 flex justify-between items-center">
                            <span
                                class="text-xs font-bold text-gray-400 uppercase"
                                >{completedItems} / {totalItems} TASKS</span
                            >
                            <a
                                href={`/learning/${roadmapData.id}`}
                                class="text-xs font-bold text-anime-blue hover:text-anime-pink transition-colors flex items-center gap-1"
                            >
                                CONTINUE <ArrowRight className="w-3 h-3" />
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 背景装饰 (Enhanced) -->
        <div
            class="absolute top-1/2 left-0 w-80 h-80 bg-anime-blue/10 rounded-full blur-[100px] -translate-y-1/2 -translate-x-1/2 pointer-events-none"
        >
        </div>
        <div
            class="absolute top-1/2 right-0 w-80 h-80 bg-anime-pink/10 rounded-full blur-[100px] -translate-y-1/2 translate-x-1/2 pointer-events-none"
        >
        </div>

        <style>
            @keyframes slide {
                from {
                    background-position: 0 0;
                }
                to {
                    background-position: 40px 0;
                }
            }
        </style>
    </section>

    <!-- Latest Posts Section -->
    <section class="py-20 bg-gray-50 dark:bg-[#181818]">
        <div class="container-custom">
            <div class="flex items-end justify-between mb-12">
                <div>
                    <h2
                        class="text-4xl md:text-5xl font-display font-bold text-anime-dark dark:text-white mb-4 relative inline-block"
                    >
                        最新回放
                        <span
                            class="absolute -bottom-2 left-0 w-full h-3 bg-anime-yellow/30 -z-10 skew-x-12"
                        ></span>
                    </h2>
                    <p class="text-anime-dark/60 dark:text-gray-400 max-w-xl">
                        探索最新的冒险记录，获取编码技能点。
                    </p>
                </div>
                <a
                    href="/blog"
                    class="hidden md:flex items-center gap-2 font-bold text-anime-dark dark:text-white hover:text-anime-pink transition-colors group"
                >
                    查看全部文章
                    <ArrowRight
                        className="w-4 h-4 group-hover:translate-x-1 transition-transform"
                    />
                </a>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                {posts.map((post) => <BlogCard post={post} />)}
            </div>

            <div class="mt-12 text-center md:hidden">
                <a
                    href="/blog"
                    class="inline-flex items-center gap-2 px-6 py-3 bg-white dark:bg-white/5 border-2 border-anime-dark dark:border-white/10 rounded-xl font-bold text-anime-dark dark:text-white shadow-comic-sm"
                >
                    查看全部文章
                    <ArrowRight className="w-4 h-4" />
                </a>
            </div>
        </div>
    </section>
</BaseLayout>

<style>
    @keyframes typing {
        from {
            width: 0;
        }
        to {
            width: 100%;
        }
    }
    .animate-typing {
        width: 0;
        animation: typing 3s steps(40, end) forwards;
        animation-delay: 0.5s;
        width: 100%; /* Fallback */
    }

    @keyframes scroll-down {
        0% {
            opacity: 0;
            transform: translateY(0);
        }
        50% {
            opacity: 1;
        }
        100% {
            opacity: 0;
            transform: translateY(8px);
        }
    }
    .animate-scroll-down {
        animation: scroll-down 1.5s infinite;
    }
</style>
