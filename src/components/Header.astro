---
import { Menu, Sun, Moon, Zap, ChevronDown } from "lucide-react";
import { getCollection } from "astro:content";

// Primary nav items - always visible
const primaryNav = [
    { name: "首页", href: "/", alt: "Home" },
    { name: "博客", href: "/blog", alt: "Blog" },
    { name: "追番", href: "/anime", alt: "Anime" },
    { name: "专栏", href: "/series", alt: "Series" },
];

// Secondary nav items - hidden in "More" dropdown
const secondaryNav = [
    { name: "学习", href: "/learning", alt: "Learning" },
    { name: "留言板", href: "/guestbook", alt: "Guestbook" },
    { name: "关于", href: "/about", alt: "About" },
];

// Combined for mobile menu
const allNavItems = [...primaryNav, ...secondaryNav];

// Get all posts for the "Random Adventure" button
const allPosts = await getCollection("blog");
const allSlugs = allPosts.map((post) => post.slug);
---

<header
    class="fixed top-0 left-0 right-0 z-50 transition-all duration-300"
    id="main-header"
>
    <div
        class="absolute inset-0 bg-white/80 dark:bg-[#121212]/90 backdrop-blur-md border-b border-gray-100 dark:border-white/5 shadow-sm transition-colors duration-500"
    >
    </div>

    <nav
        class="container-custom h-20 flex items-center justify-between relative z-10"
    >
        <!-- Logo Area -->
        <a href="/" class="flex items-center gap-3 group">
            <div
                class="relative w-10 h-10 md:w-11 md:h-11 rounded-full overflow-hidden bg-white shadow-sm ring-2 ring-gray-100 dark:ring-white/10 group-hover:scale-110 group-hover:ring-anime-pink/30 transition-all duration-300"
            >
                <img
                    src="/mascot.png"
                    alt="Mascot"
                    class="w-full h-full object-cover"
                />
            </div>
            <div class="flex flex-col">
                <span
                    class="font-display font-bold text-xl text-anime-dark dark:text-white tracking-tight group-hover:text-anime-pink transition-colors"
                >
                    ANIME<span class="text-anime-blue">.LOG</span>
                </span>
            </div>
        </a>

        <!-- Desktop Nav -->
        <div class="hidden md:flex items-center gap-3">
            <!-- Nav Pill Container -->
            <div
                class="flex items-center bg-gray-100/80 dark:bg-white/5 backdrop-blur-sm border border-black/5 dark:border-white/10 rounded-full p-1.5 transition-colors mr-2"
            >
                {
                    primaryNav.map((item) => {
                        const isActive =
                            item.href === "/"
                                ? Astro.url.pathname === "/"
                                : Astro.url.pathname.startsWith(item.href);
                        return (
                            <a
                                href={item.href}
                                class:list={[
                                    "relative px-4 py-1.5 rounded-full font-bold text-sm transition-all duration-200",
                                    isActive
                                        ? "bg-white dark:bg-white/10 text-anime-blue shadow-sm"
                                        : "text-gray-600 dark:text-gray-400 hover:text-anime-dark dark:hover:text-white hover:bg-gray-200/50 dark:hover:bg-white/5",
                                ]}
                            >
                                {item.name}
                                {isActive && (
                                    <span class="absolute -bottom-1 left-1/2 -translate-x-1/2 w-1 h-1 bg-anime-blue rounded-full" />
                                )}
                            </a>
                        );
                    })
                }

                <!-- More Dropdown -->
                <div class="relative" id="more-dropdown-container">
                    <button
                        id="more-dropdown-btn"
                        class:list={[
                            "flex items-center gap-1 px-3 py-1.5 rounded-full font-bold text-sm transition-all duration-200",
                            secondaryNav.some((item) =>
                                item.href === "/"
                                    ? Astro.url.pathname === "/"
                                    : Astro.url.pathname.startsWith(item.href),
                            )
                                ? "bg-white dark:bg-white/10 text-anime-blue shadow-sm"
                                : "text-gray-600 dark:text-gray-400 hover:text-anime-dark dark:hover:text-white hover:bg-gray-200/50 dark:hover:bg-white/5",
                        ]}
                    >
                        更多
                        <ChevronDown
                            className="w-4 h-4 transition-transform"
                            id="more-chevron"
                        />
                    </button>

                    <!-- Dropdown Panel -->
                    <div
                        id="more-dropdown-panel"
                        class="hidden absolute top-full right-0 mt-2 w-40 bg-white dark:bg-zinc-900 rounded-xl shadow-lg border border-gray-100 dark:border-white/10 py-2 z-50 animate-fade-in"
                    >
                        {
                            secondaryNav.map((item) => {
                                const isActive =
                                    item.href === "/"
                                        ? Astro.url.pathname === "/"
                                        : Astro.url.pathname.startsWith(
                                              item.href,
                                          );
                                return (
                                    <a
                                        href={item.href}
                                        class:list={[
                                            "block px-4 py-2 text-sm font-medium transition-colors",
                                            isActive
                                                ? "bg-anime-blue/5 text-anime-blue"
                                                : "text-gray-600 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-white/5 hover:text-anime-dark dark:hover:text-white",
                                        ]}
                                    >
                                        <span class="flex items-center justify-between">
                                            {item.name}
                                            <span class="text-[10px] opacity-40">
                                                {item.alt}
                                            </span>
                                        </span>
                                    </a>
                                );
                            })
                        }
                    </div>
                </div>
            </div>

            <!-- Theme & Random Buttons -->
            <div
                class="flex items-center gap-2 pl-2 border-l border-gray-200 dark:border-white/10"
            >
                <button
                    id="theme-toggle"
                    class="p-2 rounded-full hover:bg-gray-100 dark:hover:bg-white/10 text-gray-600 dark:text-gray-400 transition-colors group"
                    aria-label="切换主题"
                >
                    <div class="relative w-5 h-5">
                        <Sun
                            className="w-5 h-5 absolute inset-0 transition-transform duration-500 rotate-0 dark:rotate-90 dark:opacity-0"
                        />
                        <Moon
                            className="w-5 h-5 absolute inset-0 transition-transform duration-500 -rotate-90 opacity-0 dark:rotate-0 dark:opacity-100"
                        />
                    </div>
                </button>

                <button
                    id="random-post-btn"
                    data-slugs={JSON.stringify(allSlugs)}
                    class="p-2 rounded-full hover:bg-anime-pink/10 text-anime-pink transition-colors group relative"
                    aria-label="随机冒险"
                >
                    <Zap
                        className="w-5 h-5 fill-current group-hover:scale-110 transition-transform"
                    />
                </button>
            </div>
        </div>

        <!-- Mobile Menu Button -->
        <button
            class="md:hidden p-2 rounded-lg hover:bg-gray-100 dark:hover:bg-white/5 transition-colors"
            id="mobile-menu-button"
        >
            <Menu className="w-6 h-6 text-anime-dark dark:text-white" />
        </button>
    </nav>

    <!-- Mobile Nav -->
    <div
        id="mobile-menu"
        class="hidden md:hidden absolute top-full left-0 right-0 bg-white dark:bg-[#1a1a1a] border-b border-gray-100 dark:border-white/5 p-4 shadow-lg space-y-2 animate-fade-in origin-top"
    >
        {
            allNavItems.map((item) => {
                const isActive =
                    item.href === "/"
                        ? Astro.url.pathname === "/"
                        : Astro.url.pathname.startsWith(item.href);
                return (
                    <a
                        href={item.href}
                        class:list={[
                            "block px-4 py-3 font-bold rounded-xl transition-all border",
                            isActive
                                ? "bg-anime-blue/5 border-anime-blue/20 text-anime-blue"
                                : "border-transparent text-gray-600 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-white/5",
                        ]}
                    >
                        <span class="flex items-center justify-between">
                            {item.name}
                            <span class="text-xs font-normal opacity-50">
                                {item.alt}
                            </span>
                        </span>
                    </a>
                );
            })
        }
        <div
            class="grid grid-cols-2 gap-3 pt-4 border-t border-gray-100 dark:border-white/5 mt-2"
        >
            <button
                id="mobile-theme-toggle"
                class="flex items-center justify-center gap-2 p-3 bg-gray-50 dark:bg-white/5 rounded-xl font-bold text-sm text-gray-700 dark:text-gray-300"
            >
                <Sun className="w-4 h-4 dark:hidden" />
                <Moon className="w-4 h-4 hidden dark:block" />
                切换主题
            </button>
            <button
                id="mobile-random-btn"
                class="flex items-center justify-center gap-2 p-3 bg-anime-pink/10 text-anime-pink rounded-xl font-bold text-sm"
            >
                <Zap className="w-4 h-4 fill-current" />
                随机传送
            </button>
        </div>
    </div>
</header>

<script>
    function setupHeader() {
        const themeToggle = document.getElementById("theme-toggle");
        const mobileThemeToggle = document.getElementById(
            "mobile-theme-toggle",
        );
        const mobileMenuButton = document.getElementById("mobile-menu-button");
        const mobileMenu = document.getElementById("mobile-menu");

        // Random Post Logic
        const randomBtns = [
            document.getElementById("random-post-btn"),
            document.getElementById("mobile-random-btn"),
        ];

        // Theme Logic
        const toggleTheme = () => {
            const element = document.documentElement;
            element.classList.toggle("dark");
            const isDark = element.classList.contains("dark");
            localStorage.setItem("theme", isDark ? "dark" : "light");
        };

        themeToggle?.addEventListener("click", toggleTheme);
        mobileThemeToggle?.addEventListener("click", toggleTheme);

        mobileMenuButton?.addEventListener("click", () => {
            mobileMenu?.classList.toggle("hidden");
        });

        // Random Adventure Logic
        randomBtns.forEach((btn) => {
            if (!btn) return;
            btn.addEventListener("click", () => {
                // Get slugs from desktop button data attribute (source of truth)
                const desktopBtn = document.getElementById("random-post-btn");
                const slugsFn = desktopBtn?.dataset.slugs;

                if (slugsFn) {
                    try {
                        const slugs = JSON.parse(slugsFn);
                        if (slugs.length > 0) {
                            const randomSlug =
                                slugs[Math.floor(Math.random() * slugs.length)];
                            window.location.href = `/blog/${randomSlug}`;
                        } else {
                            alert("暂无冒险可供传送！(No posts found)");
                        }
                    } catch (e) {
                        console.error("Error parsing slugs", e);
                    }
                } else {
                    // Fallback if data attribute is missing
                    window.location.href = "/blog";
                }
            });
        });

        // More Dropdown Logic
        const moreBtn = document.getElementById("more-dropdown-btn");
        const morePanel = document.getElementById("more-dropdown-panel");
        const moreChevron = document.getElementById("more-chevron");

        moreBtn?.addEventListener("click", (e) => {
            e.stopPropagation();
            morePanel?.classList.toggle("hidden");
            moreChevron?.classList.toggle("rotate-180");
        });

        // Close dropdown when clicking outside
        document.addEventListener("click", (e) => {
            const container = document.getElementById(
                "more-dropdown-container",
            );
            if (container && !container.contains(e.target as Node)) {
                morePanel?.classList.add("hidden");
                moreChevron?.classList.remove("rotate-180");
            }
        });
    }

    setupHeader();
    document.addEventListener("astro:after-swap", setupHeader);
</script>

<style>
    @keyframes fade-in {
        from {
            opacity: 0;
            transform: translateY(-10px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
    .animate-fade-in {
        animation: fade-in 0.2s ease-out forwards;
    }
</style>
