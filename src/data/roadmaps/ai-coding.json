                },
                {
                    "id": "w9-def",
                    "text": "“完成定义”：",
                    "completed": false,
                    "children": [
                        {
                            "id": "w9-def1",
                            "text": "你改 chunk/检索/Prompt 后，评测脚本能跑出“前后对比”",
